function buildPool(list) {                    // 原始数组 → 电台池(真坐标 + 散布)
  const byCC = {}, placed = new Set();
  stations = [];
  for (const s of list) {
    const ok = isFinite(+s.geo_lat) && isFinite(+s.geo_long)
            && !(+s.geo_lat === 0 && +s.geo_long === 0)    // (0,0)=未标注
            && geoPlausible(s.countrycode, +s.geo_lat, +s.geo_long);  // 错标过滤
    if (ok) {
      stations.push(mkT(s));
      placed.add(s.stationuuid);
      (byCC[s.countrycode] ||= []).push([+s.geo_lat, +s.geo_long]);
    }
  }
  for (const s of list) {
    if (stations.length >= CAP) break;
    if (placed.has(s.stationuuid)) continue;   // 已按真坐标入池,别再散布一份
    const p = placeLatLon(s, byCC);
    if (!p) continue;
    stations.push(mkT(s, p));
  }